---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';

// Check authentication
const { data: { session } } = await supabase.auth.getSession();

if (!session) {
  return Astro.redirect('/auth/login');
}

const user = session.user;

// Get user's integrations
const { data: integrations } = await supabase
  .from('integrations')
  .select('*')
  .eq('user_id', user.id);

const hubspot = integrations?.find(i => i.provider === 'hubspot');
const sheets = integrations?.find(i => i.provider === 'google_sheets');
const salesforce = integrations?.find(i => i.provider === 'salesforce');
const airtable = integrations?.find(i => i.provider === 'airtable');

// Check for success/error messages in URL
const url = Astro.url;
const successParam = url.searchParams.get('success');
const errorParam = url.searchParams.get('error');
---

<Layout title="Integrations | PullLeads">
  <div class="dashboard">
    <!-- Header -->
    <header class="dash-header">
      <div class="logo">
        <a href="/">PullLeads</a>
      </div>
      <nav class="dash-nav">
        <a href="/dashboard">Dashboard</a>
        <a href="/dashboard/extract">Extract Leads</a>
        <a href="/dashboard/integrations" class="active">Integrations</a>
      </nav>
      <div class="user-menu">
        <span class="user-email">{user.email}</span>
        <a href="/auth/logout" class="logout-link">Logout</a>
      </div>
    </header>

    <!-- Main Content -->
    <main class="integrations-main">
      <h1>Integrations</h1>
      <p class="subtitle">Connect your favorite tools to automatically sync leads.</p>

      {successParam && (
        <div class="alert alert-success">
          Successfully connected {successParam}!
        </div>
      )}

      {errorParam && (
        <div class="alert alert-error">
          Failed to connect: {errorParam.replace(/_/g, ' ')}
        </div>
      )}

      <div class="integrations-grid">
        <!-- HubSpot -->
        <div class="integration-card">
          <div class="integration-header">
            <div class="integration-icon hubspot">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.164 7.93V5.084a2.198 2.198 0 001.267-1.984 2.21 2.21 0 00-4.42 0c0 .873.518 1.622 1.26 1.968v2.862a5.064 5.064 0 00-2.348 1.058l-6.202-4.83a2.644 2.644 0 00.06-.545A2.658 2.658 0 105.12 6.272c0 .48.13.93.357 1.318l-1.99 1.818a.75.75 0 00-.056 1.06.75.75 0 001.06.055l2.018-1.843c.513.336 1.127.532 1.79.532.18 0 .357-.015.53-.043l1.254 4.82a2.658 2.658 0 101.328-.346l-1.19-4.576a5.05 5.05 0 001.71-1.318l6.078 4.735a2.643 2.643 0 00-.054.533 2.658 2.658 0 105.316 0c0-1.218-.826-2.243-1.95-2.553l-.157-.054z"/>
              </svg>
            </div>
            <div class="integration-info">
              <h3>HubSpot</h3>
              <p>Sync leads directly to your HubSpot CRM as contacts.</p>
            </div>
          </div>

          <div class="integration-status">
            {hubspot?.is_active ? (
              <span class="status connected">Connected</span>
            ) : (
              <span class="status disconnected">Not connected</span>
            )}
          </div>

          <div class="integration-actions">
            {hubspot?.is_active ? (
              <button class="btn-secondary disconnect-btn" data-provider="hubspot">
                Disconnect
              </button>
            ) : (
              <button class="btn-primary connect-hubspot-btn">
                Connect HubSpot
              </button>
            )}
          </div>
        </div>

        <!-- Google Sheets -->
        <div class="integration-card">
          <div class="integration-header">
            <div class="integration-icon sheets">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V5h14v14zM7 7h2v2H7zm0 4h2v2H7zm0 4h2v2H7zm4-8h6v2h-6zm0 4h6v2h-6zm0 4h6v2h-6z"/>
              </svg>
            </div>
            <div class="integration-info">
              <h3>Google Sheets</h3>
              <p>Export leads directly to a Google Spreadsheet.</p>
            </div>
          </div>

          <div class="integration-status">
            {sheets?.is_active ? (
              <span class="status connected">Connected</span>
            ) : (
              <span class="status disconnected">Not connected</span>
            )}
          </div>

          <div class="integration-actions">
            {sheets?.is_active ? (
              <>
                <input
                  type="text"
                  class="spreadsheet-input"
                  placeholder="Spreadsheet ID"
                  value={sheets.config?.spreadsheet_id || ''}
                  data-provider="google_sheets"
                />
                <button class="btn-secondary disconnect-btn" data-provider="google_sheets">
                  Disconnect
                </button>
              </>
            ) : (
              <button class="btn-primary connect-sheets-btn">
                Connect Google Sheets
              </button>
            )}
          </div>
        </div>

        <!-- Salesforce -->
        <div class="integration-card">
          <div class="integration-header">
            <div class="integration-icon salesforce">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10.2 3.6c1.1-1.2 2.7-2 4.5-2 2.5 0 4.6 1.5 5.5 3.6.7-.3 1.5-.4 2.3-.4 3 0 5.5 2.5 5.5 5.5s-2.5 5.5-5.5 5.5c-.4 0-.7 0-1.1-.1-.8 2-2.7 3.4-5 3.4-1.3 0-2.5-.5-3.4-1.3-1 1.5-2.6 2.4-4.5 2.4-2.3 0-4.3-1.5-5-3.6-.5.1-1 .2-1.5.2C.9 16.8-1 14.9-1 12.5c0-1.9 1.2-3.5 2.9-4.2-.1-.4-.2-.9-.2-1.3 0-2.8 2.2-5 5-5 1.3 0 2.5.5 3.5 1.6z"/>
              </svg>
            </div>
            <div class="integration-info">
              <h3>Salesforce</h3>
              <p>Create leads or contacts directly in Salesforce CRM.</p>
            </div>
          </div>

          <div class="integration-status">
            {salesforce?.is_active ? (
              <span class="status connected">Connected</span>
            ) : (
              <span class="status disconnected">Not connected</span>
            )}
          </div>

          <div class="integration-actions">
            {salesforce?.is_active ? (
              <button class="btn-secondary disconnect-btn" data-provider="salesforce">
                Disconnect
              </button>
            ) : (
              <button class="btn-primary connect-salesforce-btn">
                Connect Salesforce
              </button>
            )}
          </div>
        </div>

        <!-- Airtable -->
        <div class="integration-card">
          <div class="integration-header">
            <div class="integration-icon airtable">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M11.992 2L2 6.5v11l9.992 4.5L22 17.5v-11L11.992 2zm0 2.25l7.5 3.375v7.5l-7.5 3.375-7.5-3.375v-7.5l7.5-3.375z"/>
                <path d="M12 9.75L8.25 12 12 14.25 15.75 12 12 9.75z"/>
              </svg>
            </div>
            <div class="integration-info">
              <h3>Airtable</h3>
              <p>Export leads to your Airtable base automatically.</p>
            </div>
          </div>

          <div class="integration-status">
            {airtable?.is_active ? (
              <span class="status connected">Connected</span>
            ) : (
              <span class="status disconnected">Not connected</span>
            )}
          </div>

          <div class="integration-actions">
            {airtable?.is_active ? (
              <>
                {airtable.config?.bases && airtable.config.bases.length > 0 && (
                  <select class="base-select" id="airtable-base-select" data-provider="airtable">
                    {airtable.config.bases.map((base: any) => (
                      <option value={base.id} selected={base.id === airtable.config.base_id}>
                        {base.name}
                      </option>
                    ))}
                  </select>
                )}
                <button class="btn-secondary disconnect-btn" data-provider="airtable">
                  Disconnect
                </button>
              </>
            ) : (
              <button class="btn-primary connect-airtable-btn">
                Connect Airtable
              </button>
            )}
          </div>
        </div>

        <!-- Webhooks -->
        <div class="integration-card">
          <div class="integration-header">
            <div class="integration-icon webhook">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                <path d="M10 15l-4 4l1.41 1.41L10 18.83l3.59 3.58L15 21l-5-5zm4-6l4-4l-1.41-1.41L14 6.17l-3.59-3.58L9 4l5 5zm-2 4a2 2 0 11-4 0a2 2 0 014 0zm6 0a2 2 0 11-4 0a2 2 0 014 0zm-12 0a2 2 0 11-4 0a2 2 0 014 0z"/>
              </svg>
            </div>
            <div class="integration-info">
              <h3>Webhooks</h3>
              <p>Send leads to any URL via HTTP POST (Zapier, Make, n8n).</p>
            </div>
          </div>

          <div class="integration-status">
            <span class="status available">Always available</span>
          </div>

          <div class="integration-actions">
            <p class="webhook-note">
              Add a webhook URL when creating an extraction to receive leads automatically.
            </p>
          </div>
        </div>
      </div>

      <!-- HubSpot OAuth Modal -->
      <div id="hubspot-modal" class="modal" style="display: none;">
        <div class="modal-content">
          <h3>Connect HubSpot</h3>
          <p>Enter your HubSpot Private App access token.</p>
          <p class="modal-hint">
            Create one in HubSpot: Settings → Integrations → Private Apps → Create
          </p>
          <input
            type="password"
            id="hubspot-token"
            placeholder="pat-na1-xxxxxxxx..."
            class="modal-input"
          />
          <div class="modal-actions">
            <button class="btn-secondary" id="hubspot-cancel">Cancel</button>
            <button class="btn-primary" id="hubspot-save">Save</button>
          </div>
        </div>
      </div>

      <!-- Google Sheets Modal -->
      <div id="sheets-modal" class="modal" style="display: none;">
        <div class="modal-content">
          <h3>Connect Google Sheets</h3>
          <p>Enter your Google Spreadsheet ID.</p>
          <p class="modal-hint">
            Find it in the URL: docs.google.com/spreadsheets/d/<strong>SPREADSHEET_ID</strong>/edit
          </p>
          <input
            type="text"
            id="sheets-id"
            placeholder="1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgvE2upms"
            class="modal-input"
          />
          <p class="modal-hint">
            Make sure to share the sheet with: <code>pulleads@pulleads.iam.gserviceaccount.com</code>
          </p>
          <div class="modal-actions">
            <button class="btn-secondary" id="sheets-cancel">Cancel</button>
            <button class="btn-primary" id="sheets-save">Save</button>
          </div>
        </div>
      </div>

      <!-- Salesforce Modal -->
      <div id="salesforce-modal" class="modal" style="display: none;">
        <div class="modal-content">
          <h3>Connect Salesforce</h3>
          <p>Choose how to connect:</p>
          <div class="connect-options">
            <a href="/api/integrations/salesforce" class="btn-primary connect-option">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/>
              </svg>
              Connect with OAuth
            </a>
            <div class="divider"><span>or</span></div>
            <div class="manual-connect">
              <input
                type="text"
                id="sf-instance-url"
                placeholder="https://yourorg.salesforce.com"
                class="modal-input"
              />
              <input
                type="password"
                id="sf-access-token"
                placeholder="Access Token"
                class="modal-input"
              />
              <button class="btn-secondary" id="salesforce-manual-save">Connect Manually</button>
            </div>
          </div>
          <div class="modal-actions">
            <button class="btn-secondary" id="salesforce-cancel">Cancel</button>
          </div>
        </div>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  // Get current session
  async function getSession() {
    const { data: { session } } = await supabase.auth.getSession();
    return session;
  }

  // HubSpot connection
  const hubspotModal = document.getElementById('hubspot-modal') as HTMLDivElement;
  const hubspotToken = document.getElementById('hubspot-token') as HTMLInputElement;
  const hubspotSave = document.getElementById('hubspot-save') as HTMLButtonElement;
  const hubspotCancel = document.getElementById('hubspot-cancel') as HTMLButtonElement;
  const connectHubspotBtn = document.querySelector('.connect-hubspot-btn') as HTMLButtonElement;

  if (connectHubspotBtn) {
    connectHubspotBtn.addEventListener('click', () => {
      hubspotModal.style.display = 'flex';
    });
  }

  hubspotCancel?.addEventListener('click', () => {
    hubspotModal.style.display = 'none';
    hubspotToken.value = '';
  });

  hubspotSave?.addEventListener('click', async () => {
    const token = hubspotToken.value.trim();
    if (!token) return;

    hubspotSave.disabled = true;
    hubspotSave.textContent = 'Saving...';

    try {
      const session = await getSession();
      if (!session) {
        window.location.href = '/auth/login';
        return;
      }

      const response = await fetch('/api/integrations/hubspot', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ accessToken: token }),
      });

      const result = await response.json();

      if (response.ok) {
        window.location.reload();
      } else {
        alert(result.error || 'Failed to connect HubSpot');
      }
    } catch (error) {
      console.error('HubSpot connect error:', error);
      alert('Failed to connect HubSpot');
    } finally {
      hubspotSave.disabled = false;
      hubspotSave.textContent = 'Save';
    }
  });

  // Google Sheets connection
  const sheetsModal = document.getElementById('sheets-modal') as HTMLDivElement;
  const sheetsId = document.getElementById('sheets-id') as HTMLInputElement;
  const sheetsSave = document.getElementById('sheets-save') as HTMLButtonElement;
  const sheetsCancel = document.getElementById('sheets-cancel') as HTMLButtonElement;
  const connectSheetsBtn = document.querySelector('.connect-sheets-btn') as HTMLButtonElement;

  if (connectSheetsBtn) {
    connectSheetsBtn.addEventListener('click', () => {
      sheetsModal.style.display = 'flex';
    });
  }

  sheetsCancel?.addEventListener('click', () => {
    sheetsModal.style.display = 'none';
    sheetsId.value = '';
  });

  sheetsSave?.addEventListener('click', async () => {
    const spreadsheetId = sheetsId.value.trim();
    if (!spreadsheetId) return;

    sheetsSave.disabled = true;
    sheetsSave.textContent = 'Saving...';

    try {
      const session = await getSession();
      if (!session) {
        window.location.href = '/auth/login';
        return;
      }

      const response = await fetch('/api/integrations/sheets', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ spreadsheetId }),
      });

      const result = await response.json();

      if (response.ok) {
        window.location.reload();
      } else {
        alert(result.error || 'Failed to connect Google Sheets');
      }
    } catch (error) {
      console.error('Sheets connect error:', error);
      alert('Failed to connect Google Sheets');
    } finally {
      sheetsSave.disabled = false;
      sheetsSave.textContent = 'Save';
    }
  });

  // Disconnect buttons
  document.querySelectorAll('.disconnect-btn').forEach((btn) => {
    btn.addEventListener('click', async (e) => {
      const button = e.currentTarget as HTMLButtonElement;
      const provider = button.dataset.provider;

      if (!provider) return;
      if (!confirm(`Disconnect ${provider}?`)) return;

      button.disabled = true;
      button.textContent = 'Disconnecting...';

      try {
        const session = await getSession();
        if (!session) {
          window.location.href = '/auth/login';
          return;
        }

        const response = await fetch(`/api/integrations/${provider}`, {
          method: 'DELETE',
          headers: {
            'Authorization': `Bearer ${session.access_token}`,
          },
        });

        if (response.ok) {
          window.location.reload();
        } else {
          const result = await response.json();
          alert(result.error || 'Failed to disconnect');
        }
      } catch (error) {
        console.error('Disconnect error:', error);
        alert('Failed to disconnect');
      } finally {
        button.disabled = false;
        button.textContent = 'Disconnect';
      }
    });
  });

  // Salesforce connection
  const salesforceModal = document.getElementById('salesforce-modal') as HTMLDivElement;
  const salesforceCancel = document.getElementById('salesforce-cancel') as HTMLButtonElement;
  const connectSalesforceBtn = document.querySelector('.connect-salesforce-btn') as HTMLButtonElement;
  const salesforceManualSave = document.getElementById('salesforce-manual-save') as HTMLButtonElement;

  if (connectSalesforceBtn) {
    connectSalesforceBtn.addEventListener('click', () => {
      salesforceModal.style.display = 'flex';
    });
  }

  salesforceCancel?.addEventListener('click', () => {
    salesforceModal.style.display = 'none';
  });

  salesforceManualSave?.addEventListener('click', async () => {
    const instanceUrl = (document.getElementById('sf-instance-url') as HTMLInputElement).value.trim();
    const accessToken = (document.getElementById('sf-access-token') as HTMLInputElement).value.trim();

    if (!instanceUrl || !accessToken) {
      alert('Please enter both instance URL and access token');
      return;
    }

    salesforceManualSave.disabled = true;
    salesforceManualSave.textContent = 'Connecting...';

    try {
      const session = await getSession();
      if (!session) {
        window.location.href = '/auth/login';
        return;
      }

      const response = await fetch('/api/integrations/salesforce', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ accessToken, instanceUrl }),
      });

      const result = await response.json();

      if (response.ok) {
        window.location.reload();
      } else {
        alert(result.error || 'Failed to connect Salesforce');
      }
    } catch (error) {
      console.error('Salesforce connect error:', error);
      alert('Failed to connect Salesforce');
    } finally {
      salesforceManualSave.disabled = false;
      salesforceManualSave.textContent = 'Connect Manually';
    }
  });

  // Airtable connection (OAuth)
  const connectAirtableBtn = document.querySelector('.connect-airtable-btn') as HTMLButtonElement;

  if (connectAirtableBtn) {
    connectAirtableBtn.addEventListener('click', () => {
      // Redirect to OAuth flow
      window.location.href = '/api/integrations/airtable';
    });
  }

  // Airtable base selection
  const airtableBaseSelect = document.getElementById('airtable-base-select') as HTMLSelectElement;

  if (airtableBaseSelect) {
    airtableBaseSelect.addEventListener('change', async () => {
      const baseId = airtableBaseSelect.value;

      try {
        const session = await getSession();
        if (!session) return;

        await fetch('/api/integrations/airtable', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ baseId }),
        });
      } catch (error) {
        console.error('Airtable base update error:', error);
      }
    });
  }

  // Close modals on backdrop click
  document.querySelectorAll('.modal').forEach((modal) => {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        (modal as HTMLDivElement).style.display = 'none';
      }
    });
  });
</script>

<style>
  .dashboard {
    min-height: 100vh;
    background: #030304;
  }

  /* Header - same as other dashboard pages */
  .dash-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .logo a {
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    text-decoration: none;
  }

  .dash-nav {
    display: flex;
    gap: 2rem;
  }

  .dash-nav a {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
  }

  .dash-nav a:hover,
  .dash-nav a.active {
    color: white;
  }

  .user-menu {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .user-email {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .logout-link {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.4);
    text-decoration: none;
  }

  /* Main */
  .integrations-main {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  h1 {
    font-size: 2rem;
    margin: 0 0 0.5rem;
  }

  .subtitle {
    color: rgba(255, 255, 255, 0.5);
    margin: 0 0 2rem;
  }

  /* Grid */
  .integrations-grid {
    display: grid;
    gap: 1rem;
  }

  .integration-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 1.5rem;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 1.5rem;
  }

  .integration-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .integration-icon {
    width: 48px;
    height: 48px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .integration-icon.hubspot {
    background: rgba(255, 122, 89, 0.15);
    color: #ff7a59;
  }

  .integration-icon.sheets {
    background: rgba(52, 168, 83, 0.15);
    color: #34a853;
  }

  .integration-icon.webhook {
    background: rgba(147, 51, 234, 0.15);
    color: #9333ea;
  }

  .integration-icon.salesforce {
    background: rgba(0, 161, 224, 0.15);
    color: #00a1e0;
  }

  .integration-icon.airtable {
    background: rgba(252, 180, 0, 0.15);
    color: #fcb400;
  }

  /* Alerts */
  .alert {
    padding: 1rem 1.25rem;
    border-radius: 8px;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .alert-success {
    background: rgba(34, 197, 94, 0.1);
    border: 1px solid rgba(34, 197, 94, 0.2);
    color: #22c55e;
  }

  .alert-error {
    background: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.2);
    color: #ef4444;
  }

  /* Base select */
  .base-select {
