---
<section class="hero-section">
  <div class="container hero-grid">
    <div class="hero-content reveal-on-scroll">
      <div class="badge-pill">
        <span class="pulse"></span>
        v2.0 Now Available
      </div>
      
      <h1>
        Extract leads <br />
        <span class="font-serif text-gradient">with precision.</span>
      </h1>
      
      <p class="hero-sub">
        Access 200M+ verified business contacts directly from Google Maps. 
        Enrich with owner emails and sync to your CRM in seconds.
      </p>

      <div class="cta-group">
        <a href="#start" class="btn btn-primary">Start Extracting Free</a>
        <div class="user-proof">
          <div class="avatars">
            <span class="avatar" style="background-image: url('https://i.pravatar.cc/100?img=1');"></span>
            <span class="avatar" style="background-image: url('https://i.pravatar.cc/100?img=2');"></span>
            <span class="avatar" style="background-image: url('https://i.pravatar.cc/100?img=3');"></span>
          </div>
          <span class="proof-text">Trusted by 1000+ agencies</span>
        </div>
      </div>
    </div>

    <div class="hero-visual reveal-on-scroll">
      <div class="app-window glass-panel">
        <div class="window-header">
          <div class="dots">
            <span></span><span></span><span></span>
          </div>
          <div class="address-bar">pullleads.com/dashboard</div>
        </div>
        <div class="window-content">
          <!-- Mock Interface -->
          <div class="interface-grid">
            <div class="sidebar glass-panel"></div>
            <div class="main-view">
              <div class="data-row header">
                <span>Business Name</span>
                <span>Decision Maker</span>
                <span>Status</span>
              </div>
              <div class="data-row">
                <span class="business">Apex Digital</span>
                <span class="email">sarah@apex.com</span>
                <span class="tag success">Verified</span>
              </div>
              <div class="data-row">
                <span class="business">Horizon Labs</span>
                <span class="email">mike@horizon.io</span>
                <span class="tag success">Verified</span>
              </div>
              <div class="data-row">
                <span class="business">Velvet Studio</span>
                <span class="email">info@velvet.co</span>
                <span class="tag warning">Catch-all</span>
              </div>
               <div class="data-row active-scan">
                <span class="loading-bar"></span>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Floating Elements -->
        <div class="floating-card stat-card glass-panel">
          <span class="stat-label">Success Rate</span>
          <span class="stat-value">98.2%</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    position: relative;
    overflow: hidden;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 4rem;
    align-items: center;
  }

  @media (min-width: 992px) {
    .hero-grid {
      grid-template-columns: 1.1fr 1fr;
    }
  }

  /* CONTENT */
  .badge-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 99px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .pulse {
    width: 8px;
    height: 8px;
    background: var(--accent-glow);
    border-radius: 50%;
    box-shadow: 0 0 0 rgba(99, 102, 241, 0.4);
    animation: pulse 2s infinite;
  }

  .hero-sub {
    margin: 2rem 0;
    max-width: 90%;
  }

  .cta-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin-top: 1rem;
  }

  /* PROOF */
  .user-proof {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .avatars {
    display: flex;
  }

  .avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-size: cover;
    border: 2px solid var(--bg-main);
    margin-left: -10px;
  }
  .avatar:first-child { margin-left: 0; }

  .proof-text {
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* VISUAL - APP WINDOW */
  .hero-visual {
    position: relative;
    perspective: 1000px;
  }

  .app-window {
    width: 100%;
    aspect-ratio: 4/3;
    position: relative;
    transform: rotateY(-12deg) rotateX(5deg);
    transition: transform 0.5s ease;
    box-shadow: 
      0 0 0 1px rgba(255,255,255,0.1),
      0 20px 50px rgba(0,0,0,0.5);
    background: rgba(10, 10, 12, 0.8);
  }

  .hero-visual:hover .app-window {
    transform: rotateY(-8deg) rotateX(2deg);
  }

  .window-header {
    height: 48px;
    border-bottom: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    padding: 0 1.5rem;
    gap: 1.5rem;
  }

  .dots { display: flex; gap: 6px; }
  .dots span { width: 10px; height: 10px; border-radius: 50%; background: #333; }
  .dots span:nth-child(1) { background: #FF5F57; }
  .dots span:nth-child(2) { background: #FEBC2E; }
  .dots span:nth-child(3) { background: #28C840; }

  .address-bar {
    flex: 1;
    height: 24px;
    background: rgba(255,255,255,0.05);
    border-radius: 4px;
    font-size: 0.75rem;
    display: flex;
    align-items: center;
    padding-left: 1rem;
    color: var(--text-muted);
  }

  .window-content {
    padding: 1.5rem;
    height: calc(100% - 48px);
  }

  .interface-grid {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 1.5rem;
    height: 100%;
  }

  .sidebar { height: 100%; border-radius: 8px; }

  .data-row {
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr;
    padding: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.85rem;
    align-items: center;
  }

  .data-row.header {
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    font-size: 0.7rem;
    font-weight: 600;
  }
  
  .tag.success { background: rgba(16, 185, 129, 0.2); color: #34D399; }
  .tag.warning { background: rgba(245, 158, 11, 0.2); color: #FBBF24; }

  .loading-bar {
    height: 8px;
    width: 60%;
    background: var(--border-subtle);
    border-radius: 4px;
    position: relative;
    overflow: hidden;
  }

  .loading-bar::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-gradient);
    width: 40%;
    animation: load 2s infinite ease-in-out;
  }

  /* FLOATERS */
  .floating-card {
    position: absolute;
    bottom: -20px;
    right: -20px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    transform: translateZ(50px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.4);
  }

  .stat-value {
    font-family: 'Outfit', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent-glow);
  }

  .stat-label {
    font-size: 0.85rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0.4); }
    70% { box-shadow: 0 0 0 10px rgba(99, 102, 241, 0); }
    100% { box-shadow: 0 0 0 0 rgba(99, 102, 241, 0); }
  }

  @keyframes load {
    0% { transform: translateX(-100%); }
    100% { transform: translateX(300%); }
  }
</style>