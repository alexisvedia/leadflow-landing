---
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="badge fade-up">
        <span>Now in Private Beta</span>
      </div>

      <h1 class="hero-title fade-up stagger-1">
        Stop chasing <span class="text-muted">info@</span> emails.<br />
        Get <span class="data-highlight">decision-makers</span> directly.
      </h1>

      <p class="hero-description fade-up stagger-2">
        LeadFlow scrapes Google Maps, finds owner & manager emails (not generic ones),
        and verifies them with <span class="mono data-highlight">90%+</span> deliverability.
        All in one pipeline.
      </p>

      <div class="hero-stats fade-up stagger-3">
        <div class="stat">
          <span class="stat-value mono">40%</span>
          <span class="stat-label">Owner emails found</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value mono">90%+</span>
          <span class="stat-label">Deliverability rate</span>
        </div>
        <div class="stat-divider"></div>
        <div class="stat">
          <span class="stat-value mono">3-in-1</span>
          <span class="stat-label">Scrape + Enrich + Verify</span>
        </div>
      </div>

      <div class="hero-actions fade-up stagger-4">
        <a href="#waitlist" class="btn btn-primary">
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
            <path d="M10 4V16M10 4L6 8M10 4L14 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Join the Waitlist
        </a>
        <a href="#how-it-works" class="btn btn-secondary">See How It Works</a>
      </div>

      <div class="hero-niches fade-up stagger-5">
        <span class="niches-label">Perfect for:</span>
        <div class="niches-list">
          <span>Plumbers</span>
          <span>HVAC</span>
          <span>Dentists</span>
          <span>Real Estate</span>
          <span>Lawyers</span>
          <span>+10 more</span>
        </div>
      </div>
    </div>

    <div class="hero-visual fade-up stagger-6">
      <div class="data-flow">
        <div class="flow-node source">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="2"/>
            <circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="2"/>
          </svg>
          <span>Google Maps</span>
        </div>
        <div class="flow-line" data-step="1">
          <div class="flow-dot"></div>
        </div>
        <div class="flow-node process">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <rect x="3" y="3" width="18" height="18" rx="2" stroke="currentColor" stroke-width="2"/>
            <path d="M9 9h6M9 13h6M9 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
          </svg>
          <span>LeadFlow</span>
        </div>
        <div class="flow-line" data-step="2">
          <div class="flow-dot"></div>
        </div>
        <div class="flow-node output">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M3 8L12 13L21 8M3 16L12 21L21 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M3 12L12 17L21 12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>Verified Leads</span>
        </div>
      </div>

      <div class="preview-card">
        <div class="preview-header">
          <div class="preview-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="mono">leads_export.csv</span>
        </div>
        <div class="preview-content">
          <div class="preview-row header">
            <span>Business</span>
            <span>Owner Email</span>
            <span>Status</span>
          </div>
          <div class="preview-row">
            <span>Mike's Plumbing LLC</span>
            <span class="mono">mike@mikesplumbing.com</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row">
            <span>Bright Smile Dental</span>
            <span class="mono">dr.johnson@brightsmile.co</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row">
            <span>ABC Roofing Inc</span>
            <span class="mono">tom.owner@abcroofing.net</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row dim">
            <span>+497 more leads...</span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 6rem;
    position: relative;
    z-index: 2;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .hero-title .text-muted {
    color: var(--text-muted);
    text-decoration: line-through;
    text-decoration-color: var(--accent-magenta);
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 520px;
    line-height: 1.7;
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding: 1.5rem 0;
    border-top: var(--border-subtle);
    border-bottom: var(--border-subtle);
    margin: 0.5rem 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .stat-value {
    font-size: 1.75rem;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-divider {
    width: 1px;
    height: 40px;
    background: var(--border-subtle);
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .hero-niches {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .niches-label {
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .niches-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .niches-list span {
    padding: 0.375rem 0.75rem;
    background: var(--bg-elevated);
    border-radius: 100px;
    font-size: 0.8rem;
    color: var(--text-secondary);
    border: var(--border-subtle);
  }

  .niches-list span:last-child {
    color: var(--accent-cyan);
    border-color: rgba(0, 245, 212, 0.2);
    background: rgba(0, 245, 212, 0.05);
  }

  /* Visual / Data Flow */
  .hero-visual {
    position: relative;
  }

  .data-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding: 1.5rem;
    background: var(--bg-surface);
    border-radius: 16px;
    border: var(--border-subtle);
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem;
    border-radius: 12px;
    transition: all 0.3s;
  }

  .flow-node svg {
    color: var(--text-secondary);
  }

  .flow-node span {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .flow-node.source svg { color: var(--accent-magenta); }
  .flow-node.process svg { color: var(--accent-cyan); }
  .flow-node.output svg { color: var(--accent-cyan); }

  .flow-line {
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--text-muted), var(--accent-cyan));
    position: relative;
    margin: 0 1rem;
    opacity: 0.5;
  }

  .flow-dot {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--accent-cyan);
    border-radius: 50%;
    top: -3px;
    animation: flowMove 2s ease-in-out infinite;
  }

  .flow-line[data-step="2"] .flow-dot {
    animation-delay: 1s;
  }

  @keyframes flowMove {
    0%, 100% { left: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: calc(100% - 8px); opacity: 0; }
  }

  /* Preview Card */
  .preview-card {
    background: var(--bg-surface);
    border: var(--border-subtle);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: var(--shadow-elevated);
  }

  .preview-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.5rem;
    background: var(--bg-elevated);
    border-bottom: var(--border-subtle);
  }

  .preview-dots {
    display: flex;
    gap: 6px;
  }

  .preview-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .preview-dots span:first-child { background: #ff5f57; }
  .preview-dots span:nth-child(2) { background: #febc2e; }
  .preview-dots span:last-child { background: #28c840; }

  .preview-header .mono {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .preview-content {
    padding: 0.5rem;
  }

  .preview-row {
    display: grid;
    grid-template-columns: 1.5fr 2fr 0.8fr;
    gap: 1rem;
    padding: 0.75rem 1rem;
    font-size: 0.85rem;
    border-radius: 8px;
    transition: background 0.2s;
  }

  .preview-row:not(.header):not(.dim):hover {
    background: rgba(0, 245, 212, 0.05);
  }

  .preview-row.header {
    color: var(--text-muted);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: var(--border-subtle);
  }

  .preview-row .mono {
    color: var(--accent-cyan);
    font-size: 0.8rem;
  }

  .preview-row.dim {
    color: var(--text-muted);
    font-style: italic;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .status.verified {
    color: #28c840;
  }

  .status.verified::before {
    content: '';
    width: 6px;
    height: 6px;
    background: currentColor;
    border-radius: 50%;
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero {
      min-height: auto;
      padding-top: 8rem;
      padding-bottom: 4rem;
    }

    .hero-stats {
      flex-wrap: wrap;
    }

    .stat-divider {
      display: none;
    }

    .stat {
      flex: 1;
      min-width: 120px;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .preview-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .preview-row.header {
      display: none;
    }

    .data-flow {
      flex-direction: column;
      gap: 1rem;
    }

    .flow-line {
      width: 2px;
      height: 30px;
      margin: 0;
      background: linear-gradient(180deg, var(--text-muted), var(--accent-cyan));
    }

    .flow-dot {
      left: -3px !important;
      animation: flowMoveVertical 2s ease-in-out infinite;
    }

    @keyframes flowMoveVertical {
      0%, 100% { top: 0; opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { top: calc(100% - 8px); opacity: 0; }
    }
  }
</style>
