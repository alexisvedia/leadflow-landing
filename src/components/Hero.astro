---
---

<section class="hero">
  <div class="container">
    <div class="hero-content">
      <div class="badge fade-up">
        <span>Now in Private Beta</span>
      </div>

      <h1 class="hero-title fade-up stagger-1">
        Pull leads that<br />
        <span class="data-highlight">actually convert</span>
      </h1>

      <p class="hero-description fade-up stagger-2">
        Stop wasting time on generic info@ emails. PullLeads extracts owner and decision-maker
        contacts from Google Maps, then verifies them for <span class="mono data-highlight">90%+</span> deliverability.
      </p>

      <div class="hero-stats fade-up stagger-3">
        <div class="stat">
          <span class="stat-value mono">40%</span>
          <span class="stat-label">Owner emails found</span>
        </div>
        <div class="stat">
          <span class="stat-value mono">90%+</span>
          <span class="stat-label">Deliverability rate</span>
        </div>
        <div class="stat">
          <span class="stat-value mono">3-in-1</span>
          <span class="stat-label">Scrape + Enrich + Verify</span>
        </div>
      </div>

      <div class="hero-actions fade-up stagger-4">
        <a href="#waitlist" class="btn btn-primary">
          Get Early Access
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a href="#how-it-works" class="btn btn-secondary">See How It Works</a>
      </div>

      <div class="hero-niches fade-up stagger-5">
        <span class="niches-label">Built for:</span>
        <div class="niches-list">
          <span>Home Services</span>
          <span>Healthcare</span>
          <span>Real Estate</span>
          <span>Legal</span>
          <span class="more">+12 more</span>
        </div>
      </div>
    </div>

    <div class="hero-visual fade-up stagger-6">
      <div class="data-flow">
        <div class="flow-node source">
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="9" r="2" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <span>Google Maps</span>
        </div>
        <div class="flow-connector">
          <div class="connector-line"></div>
          <div class="connector-dot"></div>
        </div>
        <div class="flow-node process active">
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-width="2"/>
              <path d="M8 9h8M8 13h8M8 17h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
            </svg>
          </div>
          <span>PullLeads</span>
        </div>
        <div class="flow-connector">
          <div class="connector-line"></div>
          <div class="connector-dot"></div>
        </div>
        <div class="flow-node output">
          <div class="node-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/>
            </svg>
          </div>
          <span>Verified Leads</span>
        </div>
      </div>

      <div class="preview-card">
        <div class="preview-header">
          <div class="preview-dots">
            <span></span><span></span><span></span>
          </div>
          <span class="mono">leads_export.csv</span>
        </div>
        <div class="preview-content">
          <div class="preview-row header">
            <span>Business</span>
            <span>Owner Email</span>
            <span>Status</span>
          </div>
          <div class="preview-row">
            <span>Mike's Plumbing LLC</span>
            <span class="mono email">mike@mikesplumbing.com</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row">
            <span>Bright Smile Dental</span>
            <span class="mono email">dr.johnson@brightsmile.co</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row">
            <span>ABC Roofing Inc</span>
            <span class="mono email">tom@abcroofing.net</span>
            <span class="status verified">Verified</span>
          </div>
          <div class="preview-row dim">
            <span>+497 more verified leads...</span>
            <span></span>
            <span></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 5rem;
    position: relative;
    z-index: 2;
  }

  .hero .container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }

  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .hero-title {
    font-size: clamp(2.75rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .hero-description {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 480px;
    line-height: 1.7;
  }

  .hero-stats {
    display: flex;
    gap: 2.5rem;
    padding: 1.5rem 0;
    border-top: var(--border-subtle);
    border-bottom: var(--border-subtle);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .stat-value {
    font-size: 1.5rem;
    font-weight: 700;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    padding-top: 0.5rem;
  }

  .hero-niches {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .niches-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .niches-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .niches-list span {
    padding: 0.375rem 0.75rem;
    background: var(--bg-elevated);
    border-radius: var(--radius-full);
    font-size: 0.8rem;
    color: var(--text-secondary);
    border: var(--border-subtle);
  }

  .niches-list span.more {
    color: var(--accent-glow);
    border-color: rgba(99, 102, 241, 0.2);
    background: rgba(99, 102, 241, 0.08);
  }

  /* Visual / Data Flow */
  .hero-visual {
    position: relative;
  }

  .data-flow {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding: 1.25rem 1.5rem;
    background: var(--bg-surface);
    border-radius: var(--radius-lg);
    border: var(--border-subtle);
  }

  .flow-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-radius: var(--radius-md);
    transition: all var(--transition-normal);
  }

  .node-icon {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border-radius: var(--radius-md);
    color: var(--text-muted);
    transition: all var(--transition-normal);
  }

  .flow-node.active .node-icon {
    background: rgba(99, 102, 241, 0.15);
    color: var(--accent-glow);
  }

  .flow-node span {
    font-size: 0.7rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .flow-connector {
    flex: 1;
    height: 2px;
    position: relative;
    margin: 0 0.5rem;
  }

  .connector-line {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--bg-elevated), var(--accent-primary), var(--bg-elevated));
    opacity: 0.4;
  }

  .connector-dot {
    position: absolute;
    width: 6px;
    height: 6px;
    background: var(--accent-primary);
    border-radius: 50%;
    top: -2px;
    animation: flowMove 2.5s ease-in-out infinite;
  }

  .flow-connector:last-of-type .connector-dot {
    animation-delay: 1.25s;
  }

  @keyframes flowMove {
    0%, 100% { left: 0; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { left: calc(100% - 6px); opacity: 0; }
  }

  /* Preview Card */
  .preview-card {
    background: var(--bg-surface);
    border: var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-lg);
  }

  .preview-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.875rem 1.25rem;
    background: var(--bg-elevated);
    border-bottom: var(--border-subtle);
  }

  .preview-dots {
    display: flex;
    gap: 6px;
  }

  .preview-dots span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--text-muted);
    opacity: 0.3;
  }

  .preview-dots span:first-child { background: #ef4444; opacity: 0.8; }
  .preview-dots span:nth-child(2) { background: #eab308; opacity: 0.8; }
  .preview-dots span:last-child { background: #22c55e; opacity: 0.8; }

  .preview-header .mono {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .preview-content {
    padding: 0.5rem;
  }

  .preview-row {
    display: grid;
    grid-template-columns: 1.4fr 2fr 0.7fr;
    gap: 1rem;
    padding: 0.625rem 1rem;
    font-size: 0.8rem;
    border-radius: var(--radius-sm);
    transition: background var(--transition-fast);
  }

  .preview-row:not(.header):not(.dim):hover {
    background: rgba(99, 102, 241, 0.05);
  }

  .preview-row.header {
    color: var(--text-muted);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border-bottom: var(--border-subtle);
    padding-bottom: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .preview-row .email {
    color: var(--accent-glow);
    font-size: 0.75rem;
  }

  .preview-row.dim {
    color: var(--text-muted);
    font-style: italic;
    font-size: 0.75rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .status.verified {
    color: var(--success);
  }

  .status.verified::before {
    content: '';
    width: 5px;
    height: 5px;
    background: currentColor;
    border-radius: 50%;
  }

  @media (max-width: 1024px) {
    .hero .container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    .hero {
      min-height: auto;
      padding-top: 7rem;
      padding-bottom: 4rem;
    }

    .hero-stats {
      flex-wrap: wrap;
      gap: 1.5rem;
    }

    .stat {
      min-width: 100px;
    }
  }

  @media (max-width: 600px) {
    .hero-actions {
      flex-direction: column;
    }

    .hero-actions .btn {
      width: 100%;
    }

    .preview-row {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }

    .preview-row.header {
      display: none;
    }

    .data-flow {
      flex-direction: column;
      gap: 0.75rem;
    }

    .flow-connector {
      width: 2px;
      height: 24px;
      margin: 0;
    }

    .connector-line {
      background: linear-gradient(180deg, var(--bg-elevated), var(--accent-primary), var(--bg-elevated));
    }

    .connector-dot {
      left: -2px !important;
      top: auto;
      animation: flowMoveVertical 2.5s ease-in-out infinite;
    }

    @keyframes flowMoveVertical {
      0%, 100% { top: 0; opacity: 0; }
      10% { opacity: 1; }
      90% { opacity: 1; }
      100% { top: calc(100% - 6px); opacity: 0; }
    }
  }
</style>
