---
---
<section id="pricing" class="py-24 relative">
  <div class="container">
    <div class="text-center mb-16 reveal-on-scroll">
      <h2>Simple pricing, <span class="text-gradient">ROI positive</span> instantly.</h2>
      <p class="mt-4 text-secondary">Stop overpaying for credits. Get precise data at a fraction of the cost.</p>
      
      <!-- Toggle Mock -->
      <div class="mt-8 inline-flex bg-white/5 rounded-full p-1 border border-white/10">
        <button class="px-6 py-2 rounded-full bg-accent-primary text-white text-sm font-medium">Monthly</button>
        <button class="px-6 py-2 rounded-full text-secondary text-sm font-medium hover:text-white">Yearly (-20%)</button>
      </div>
    </div>

    <div class="pricing-grid">
      <!-- Starter -->
      <div class="plan-card glass-panel reveal-on-scroll">
        <div class="plan-header">
          <h3>Starter</h3>
          <div class="price">
            <span class="currency">$</span>
            <span class="amount">49</span>
            <span class="period">/mo</span>
          </div>
          <p class="desc">For solo founders validation.</p>
        </div>
        <div class="plan-features">
          <ul>
            <li><span class="check">✓</span> 1,000 Verified Leads</li>
            <li><span class="check">✓</span> Unlimited Search</li>
            <li><span class="check">✓</span> CSV Export</li>
            <li class="dim"><span class="check">✕</span> No CRM Integration</li>
          </ul>
        </div>
        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="btn btn-secondary w-full">Get Started</a>
      </div>

      <!-- Pro -->
      <div class="plan-card popular glass-panel reveal-on-scroll">
        <div class="popular-tag">Most Popular</div>
        <div class="plan-header">
          <h3>Growth</h3>
          <div class="price">
            <span class="currency">$</span>
            <span class="amount">99</span>
            <span class="period">/mo</span>
          </div>
          <p class="desc">For scaling agencies & sales teams.</p>
        </div>
        <div class="plan-features">
          <ul>
            <li><span class="check">✓</span> 5,000 Verified Leads</li>
            <li><span class="check">✓</span> Unlimited Search</li>
            <li><span class="check">✓</span> Advanced Enrichment</li>
            <li><span class="check">✓</span> HubSpot & Salesforce Sync</li>
            <li><span class="check">✓</span> Priority Support</li>
          </ul>
        </div>
        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="btn btn-primary w-full">Start Free Trial</a>
      </div>

      <!-- Agency -->
      <div class="plan-card glass-panel reveal-on-scroll">
        <div class="plan-header">
          <h3>Scale</h3>
          <div class="price">
            <span class="currency">$</span>
            <span class="amount">249</span>
            <span class="period">/mo</span>
          </div>
          <p class="desc">Volume extraction for power users.</p>
        </div>
        <div class="plan-features">
          <ul>
            <li><span class="check">✓</span> 20,000 Verified Leads</li>
            <li><span class="check">✓</span> API Access</li>
            <li><span class="check">✓</span> White-label Reports</li>
            <li><span class="check">✓</span> Dedicated Manager</li>
          </ul>
        </div>
        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="btn btn-secondary w-full">Contact Sales</a>
      </div>
    </div>

    <!-- Pricing Note (Restored) -->
    <div class="pricing-note reveal-on-scroll">
      <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
        <circle cx="10" cy="10" r="8" stroke="currentColor" stroke-width="1.5" />
        <path d="M10 6v4M10 13v.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      </svg>
      <p>
        <strong>Early access pricing.</strong> Lock in these rates during beta.
        Prices may increase at launch.
      </p>
    </div>
  </div>
</section>

<style>
  .py-24 { padding-top: 6rem; padding-bottom: 6rem; }
  .text-center { text-align: center; }
  .mb-16 { margin-bottom: 4rem; }
  .mt-4 { margin-top: 1rem; }
  .mt-8 { margin-top: 2rem; }
  .text-secondary { color: var(--text-secondary); }
  .bg-white\/5 { background: rgba(255,255,255,0.05); }
  .border-white\/10 { border: 1px solid rgba(255,255,255,0.1); }
  .rounded-full { border-radius: 9999px; }
  .bg-accent-primary { background: var(--accent-primary); }
  .text-sm { font-size: 0.875rem; }
  .font-medium { font-weight: 500; }
  
  /* Missing Utilities */
  .inline-flex { display: inline-flex; }
  .p-1 { padding: 0.25rem; }
  .text-white { color: white; }
  .hover\:text-white:hover { color: white; }
  .px-6 { padding-left: 1.5rem; padding-right: 1.5rem; }
  .py-2 { padding-top: 0.5rem; padding-bottom: 0.5rem; }

  .pricing-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (min-width: 900px) {
    .pricing-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: center;
    }
  }

  .plan-card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    position: relative;
    transition: transform 0.3s ease;
  }

  .plan-card:hover {
    transform: translateY(-5px);
  }

  .plan-card.popular {
    border: 1px solid var(--accent-primary);
    background: linear-gradient(180deg, rgba(79, 70, 229, 0.1) 0%, rgba(10, 10, 12, 0.6) 100%);
    box-shadow: 0 0 30px rgba(79, 70, 229, 0.15);
    z-index: 10;
    transform: scale(1.05);
  }

  .plan-card.popular:hover {
    transform: scale(1.05) translateY(-5px);
  }

  .popular-tag {
    position: absolute;
    top: -12px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--accent-primary);
    color: white;
    padding: 0.25rem 0.75rem;
    border-radius: 99px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .plan-header {
    text-align: center;
  }

  .plan-header h3 {
    font-size: 1.25rem;
    margin-bottom: 1rem;
    color: var(--text-primary);
  }

  .price {
    display: flex;
    justify-content: center;
    align-items: baseline;
    color: var(--text-primary);
  }

  .currency { font-size: 1.5rem; vertical-align: top; }
  .amount { font-size: 3rem; font-weight: 700; font-family: 'Outfit', sans-serif; letter-spacing: -0.05em; }
  .period { color: var(--text-secondary); margin-left: 0.25rem; }

  .desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    margin-top: 0.5rem;
  }

  .plan-features ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .plan-features li {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.95rem;
    color: var(--text-secondary);
  }

  .check { color: var(--accent-primary); font-weight: bold; }
  .dim { opacity: 0.5; text-decoration: line-through; }

  .w-full { width: 100%; }

  /* Pricing Note */
  .pricing-note {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    max-width: 500px;
    margin: 3rem auto 0;
    padding: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: 0.9rem;
  }

  .pricing-note svg {
    flex-shrink: 0;
    color: var(--accent-glow);
    margin-top: 2px;
  }

  .pricing-note p {
    margin: 0;
    line-height: 1.5;
  }

  .pricing-note strong {
    color: var(--text-primary);
  }
</style>