---
---

<section id="pricing" class="pricing-section">
  <div class="container">

    <div class="section-header">
      <span class="section-label">Pricing</span>
      <h2>Simple pricing,<br><span class="accent-serif">instant ROI</span></h2>
    </div>

    <div class="pricing-grid">

      <!-- Starter -->
      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-name">Starter</span>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">49</span>
            <span class="period">/mo</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>1,000 verified leads</li>
          <li>Unlimited searches</li>
          <li>CSV & JSON export</li>
          <li class="disabled">CRM integrations</li>
        </ul>

        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="plan-cta">
          Get Started
        </a>
      </div>

      <!-- Growth -->
      <div class="plan-card featured">
        <div class="plan-header">
          <span class="plan-name">Growth</span>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">99</span>
            <span class="period">/mo</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>5,000 verified leads</li>
          <li>Advanced enrichment</li>
          <li>HubSpot & Salesforce sync</li>
          <li>Priority support</li>
        </ul>

        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="plan-cta primary">
          Start Free Trial
        </a>
      </div>

      <!-- Scale -->
      <div class="plan-card">
        <div class="plan-header">
          <span class="plan-name">Scale</span>
          <div class="plan-price">
            <span class="currency">$</span>
            <span class="amount">249</span>
            <span class="period">/mo</span>
          </div>
        </div>

        <ul class="plan-features">
          <li>20,000 verified leads</li>
          <li>Full API access</li>
          <li>White-label reports</li>
          <li>Dedicated manager</li>
        </ul>

        <a href="https://console.apify.com/actors/U1NdkcLzWXOfhQ7iM" target="_blank" class="plan-cta">
          Contact Sales
        </a>
      </div>

    </div>

    <p class="pricing-note">
      <span class="accent-serif">Early access pricing.</span> Lock in these rates during beta.
    </p>

  </div>
</section>

<style>
  .pricing-section {
    padding: 8rem 0;
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
  }

  .accent-serif {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Grid */
  .pricing-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  /* Card */
  .plan-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 12px;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .plan-card:hover {
    border-color: rgba(255, 255, 255, 0.1);
  }

  .plan-card.featured {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.15);
  }

  .plan-header {
    text-align: center;
    padding-bottom: 1.5rem;
    margin-bottom: 1.5rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
  }

  .plan-name {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    justify-content: center;
    margin-top: 0.75rem;
  }

  .currency {
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.5);
    margin-right: 0.125rem;
  }

  .amount {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 3rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.03em;
  }

  .period {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.4);
    margin-left: 0.25rem;
  }

  /* Features */
  .plan-features {
    list-style: none;
    padding: 0;
    margin: 0;
    flex: 1;
  }

  .plan-features li {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .plan-features li:last-child {
    border-bottom: none;
  }

  .plan-features li.disabled {
    color: rgba(255, 255, 255, 0.25);
    text-decoration: line-through;
  }

  /* CTA */
  .plan-cta {
    display: block;
    text-align: center;
    padding: 0.875rem;
    margin-top: 1.5rem;
    font-family: 'Space Grotesk', sans-serif;
    font-weight: 600;
    font-size: 0.9rem;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.2s ease;
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .plan-cta:hover {
    color: white;
    border-color: rgba(255, 255, 255, 0.2);
  }

  .plan-cta.primary {
    background: #fff;
    color: #000;
    border: none;
  }

  .plan-cta.primary:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Note */
  .pricing-note {
    text-align: center;
    margin-top: 3rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.4);
  }

  /* Responsive */
  @media (max-width: 800px) {
    .pricing-grid {
      grid-template-columns: 1fr;
      max-width: 360px;
      margin: 0 auto;
    }

    .plan-card.featured {
      order: -1;
    }
  }
</style>
