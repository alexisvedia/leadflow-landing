---
const steps = [
  {
    number: '01',
    title: 'Define Your Target',
    description: 'Choose your niche, location, and filters. Plumbers in Austin? Dentists in Miami? We support any business type on Google Maps.',
    visual: 'target'
  },
  {
    number: '02',
    title: 'We Extract & Enrich',
    description: 'PullLeads scrapes business data from Google Maps, then hunts down owner and manager emails using multiple data sources.',
    visual: 'process'
  },
  {
    number: '03',
    title: 'Verification Pipeline',
    description: 'Every email passes through SMTP validation, catch-all detection, and deliverability scoring. Only verified emails make it through.',
    visual: 'verify'
  },
  {
    number: '04',
    title: 'Export & Outreach',
    description: 'Download your verified leads as CSV or push directly to your CRM. Start reaching decision-makers with confidence.',
    visual: 'export'
  }
];
---

<section id="how-it-works" class="how-it-works">
  <div class="container">
    <div class="section-header fade-up">
      <span class="badge">How It Works</span>
      <h2>From Google Maps to<br /><span class="data-highlight">verified inbox</span></h2>
      <p>Four steps. Zero manual work. No third-party tools.</p>
    </div>

    <div class="steps-container">
      <div class="steps-line" aria-hidden="true">
        <div class="line-progress"></div>
      </div>

      {steps.map((step, index) => (
        <div class={`step fade-up stagger-${index + 1}`}>
          <div class="step-number mono">{step.number}</div>
          <div class="step-content">
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </div>
          <div class={`step-visual ${step.visual}`}>
            {step.visual === 'target' && (
              <div class="visual-target">
                <div class="target-ring"></div>
                <div class="target-ring"></div>
                <div class="target-ring"></div>
                <div class="target-center"></div>
              </div>
            )}
            {step.visual === 'process' && (
              <div class="visual-process">
                <div class="data-stream">
                  <span></span><span></span><span></span><span></span><span></span>
                </div>
              </div>
            )}
            {step.visual === 'verify' && (
              <div class="visual-verify">
                <svg width="44" height="44" viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="18" stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3" />
                  <path d="M16 24l6 6 10-10" stroke="var(--accent-primary)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="check-path" />
                </svg>
              </div>
            )}
            {step.visual === 'export' && (
              <div class="visual-export">
                <div class="export-file">
                  <span class="mono">.csv</span>
                </div>
                <div class="export-arrow">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
              </div>
            )}
          </div>
        </div>
      ))}
    </div>

    <div class="workflow-cta fade-up">
      <div class="cta-content">
        <h3>Ready to see it in action?</h3>
        <p>Join the waitlist and get early access to PullLeads</p>
      </div>
      <a href="#waitlist" class="btn btn-primary">Get Early Access</a>
    </div>
  </div>
</section>

<style>
  .how-it-works {
    position: relative;
    z-index: 2;
    background: linear-gradient(180deg, transparent 0%, var(--bg-surface) 40%, var(--bg-surface) 60%, transparent 100%);
  }

  .section-header {
    text-align: center;
    max-width: 560px;
    margin: 0 auto 5rem;
  }

  .section-header .badge {
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: 1rem;
  }

  .section-header p {
    color: var(--text-secondary);
    font-size: 1.0625rem;
  }

  .steps-container {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 880px;
    margin: 0 auto;
  }

  .steps-line {
    position: absolute;
    left: 28px;
    top: 56px;
    bottom: 56px;
    width: 1px;
    background: var(--bg-elevated);
  }

  .line-progress {
    width: 100%;
    height: 0;
    background: var(--gradient-primary);
    transition: height 1.2s var(--ease-out-expo);
  }

  .step {
    display: grid;
    grid-template-columns: 56px 1fr 180px;
    gap: 2rem;
    align-items: center;
  }

  .step-number {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border: var(--border-subtle);
    border-radius: var(--radius-md);
    font-size: 1rem;
    font-weight: 600;
    color: var(--text-muted);
    position: relative;
    z-index: 1;
    transition: all var(--transition-normal);
  }

  .step:hover .step-number {
    background: rgba(99, 102, 241, 0.1);
    border-color: rgba(99, 102, 241, 0.25);
    color: var(--accent-glow);
  }

  .step-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .step-content p {
    color: var(--text-secondary);
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .step-visual {
    width: 180px;
    height: 100px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border: var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  /* Visual: Target */
  .visual-target {
    position: relative;
    width: 70px;
    height: 70px;
  }

  .target-ring {
    position: absolute;
    border: 1.5px solid var(--accent-primary);
    border-radius: 50%;
    opacity: 0.25;
    animation: targetPulse 2.5s ease-out infinite;
  }

  .target-ring:nth-child(1) { inset: 0; animation-delay: 0s; }
  .target-ring:nth-child(2) { inset: 14px; animation-delay: 0.4s; }
  .target-ring:nth-child(3) { inset: 28px; animation-delay: 0.8s; }

  .target-center {
    position: absolute;
    inset: 32px;
    background: var(--accent-primary);
    border-radius: 50%;
  }

  @keyframes targetPulse {
    0% { transform: scale(0.85); opacity: 0; }
    50% { opacity: 0.4; }
    100% { transform: scale(1.15); opacity: 0; }
  }

  /* Visual: Process */
  .visual-process {
    width: 100%;
    height: 100%;
    position: relative;
    overflow: hidden;
  }

  .data-stream {
    display: flex;
    gap: 6px;
    position: absolute;
    top: 50%;
    left: -20px;
    transform: translateY(-50%);
    animation: streamFlow 3.5s linear infinite;
  }

  .data-stream span {
    width: 32px;
    height: 6px;
    background: var(--gradient-primary);
    border-radius: 3px;
    opacity: 0.6;
  }

  .data-stream span:nth-child(even) {
    width: 48px;
  }

  @keyframes streamFlow {
    0% { left: -180px; }
    100% { left: 180px; }
  }

  /* Visual: Verify */
  .visual-verify svg {
    color: var(--text-muted);
  }

  .check-path {
    stroke-dasharray: 28;
    stroke-dashoffset: 28;
    animation: checkDraw 0.8s ease-out forwards;
    animation-delay: 0.6s;
  }

  @keyframes checkDraw {
    to { stroke-dashoffset: 0; }
  }

  /* Visual: Export */
  .visual-export {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .export-file {
    padding: 0.625rem 1.25rem;
    background: rgba(99, 102, 241, 0.1);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: var(--radius-sm);
  }

  .export-file .mono {
    color: var(--accent-glow);
    font-size: 0.8rem;
  }

  .export-arrow {
    color: var(--accent-primary);
    animation: bounce 1.2s ease-in-out infinite;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(4px); }
  }

  /* CTA */
  .workflow-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem 2.5rem;
    background: var(--bg-elevated);
    border: var(--border-accent);
    border-radius: var(--radius-xl);
    margin-top: 4rem;
  }

  .cta-content h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .cta-content p {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }

  @media (max-width: 900px) {
    .step {
      grid-template-columns: 44px 1fr;
    }

    .step-number {
      width: 44px;
      height: 44px;
      font-size: 0.875rem;
    }

    .steps-line {
      left: 21px;
    }

    .step-visual {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .workflow-cta {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem;
    }

    .workflow-cta .btn {
      width: 100%;
    }
  }
</style>

<script>
  // Animate line progress on scroll
  const stepsContainer = document.querySelector('.steps-container');
  const lineProgress = document.querySelector('.line-progress');

  if (stepsContainer && lineProgress) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            (lineProgress as HTMLElement).style.height = '100%';
          }
        });
      },
      { threshold: 0.25 }
    );

    observer.observe(stepsContainer);
  }
</script>
