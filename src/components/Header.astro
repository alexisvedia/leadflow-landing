---
---

<header class="site-header">
  <div class="header-container">
    <nav class="nav-bar">
      <a href="/" class="logo">PullLeads</a>

      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#how-it-works">How it works</a>
        <a href="#pricing">Pricing</a>
      </div>

      <div class="nav-actions">
        <a href="/auth/login" class="nav-link">Log in</a>
        <a href="/auth/login" class="nav-btn">Get Started</a>
      </div>

      <button class="mobile-toggle" aria-label="Menu" aria-expanded="false">
        <span></span>
        <span></span>
      </button>
    </nav>

    <div class="mobile-menu">
      <a href="#features">Features</a>
      <a href="#how-it-works">How it works</a>
      <a href="#pricing">Pricing</a>
      <a href="/auth/login" class="mobile-cta">Get Started</a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 1rem 1.5rem;
  }

  .header-container {
    max-width: 1100px;
    margin: 0 auto;
    position: relative;
  }

  .nav-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.625rem 1rem;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
  }

  .logo {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-weight: 800;
    font-size: 1.125rem;
    color: white;
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: none;
    gap: 2rem;
  }

  .nav-links a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: white;
  }

  .nav-actions {
    display: none;
    align-items: center;
    gap: 1rem;
  }

  .nav-link {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: rgba(255, 255, 255, 0.5);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: white;
  }

  .nav-btn {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 1rem;
    background: #fff;
    color: #000;
    text-decoration: none;
    border-radius: 6px;
    transition: all 0.2s;
  }

  .nav-btn:hover {
    background: rgba(255, 255, 255, 0.9);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
  }

  .mobile-toggle span {
    width: 18px;
    height: 1.5px;
    background: white;
    transition: all 0.3s ease;
  }

  .mobile-toggle[aria-expanded="true"] span:first-child {
    transform: rotate(45deg) translate(3px, 4px);
  }

  .mobile-toggle[aria-expanded="true"] span:last-child {
    transform: rotate(-45deg) translate(3px, -4px);
  }

  /* Mobile Menu */
  .mobile-menu {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    right: 0;
    padding: 1.25rem;
    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    opacity: 0;
    transform: translateY(-8px);
    pointer-events: none;
    transition: all 0.2s ease;
    visibility: hidden;
  }

  .mobile-menu.open {
    opacity: 1;
    transform: translateY(0);
    pointer-events: all;
    visibility: visible;
  }

  .mobile-menu a {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.6);
    text-decoration: none;
    padding: 0.5rem 0;
    transition: color 0.2s;
  }

  .mobile-menu a:hover {
    color: white;
  }

  .mobile-cta {
    margin-top: 0.5rem;
    padding: 0.75rem !important;
    background: #fff;
    color: #000 !important;
    text-align: center;
    border-radius: 8px;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .nav-links { display: flex; }
    .nav-actions { display: flex; }
    .mobile-toggle { display: none; }
    .mobile-menu { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector('.mobile-toggle');
  const menu = document.querySelector('.mobile-menu');

  toggle?.addEventListener('click', () => {
    const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', (!isExpanded).toString());
    menu?.classList.toggle('open');
  });

  document.querySelectorAll('.mobile-menu a').forEach(link => {
    link.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      menu?.classList.remove('open');
    });
  });
</script>
