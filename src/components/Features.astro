---
---

<section id="features" class="features-section">
  <div class="container">

    <div class="section-header">
      <span class="section-label">Features</span>
      <h2>Everything you need<br><span class="accent-serif">to fill your pipeline</span></h2>
    </div>

    <div class="bento-grid">

      <!-- Large: Google Maps Integration -->
      <div class="bento-card bento-large">
        <div class="card-content">
          <span class="card-number">01</span>
          <h3>Google Maps, Unlocked</h3>
          <p>Search any niche, any city, any country. If it's on Maps, we extract it.</p>
        </div>
        <div class="card-visual">
          <!-- Animated Globe SVG -->
          <svg class="globe-svg" viewBox="0 0 200 200" fill="none">
            <circle cx="100" cy="100" r="80" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <ellipse cx="100" cy="100" rx="80" ry="30" stroke="rgba(255,255,255,0.08)" stroke-width="1" class="orbit orbit-1"/>
            <ellipse cx="100" cy="100" rx="60" ry="80" stroke="rgba(255,255,255,0.08)" stroke-width="1" class="orbit orbit-2"/>
            <ellipse cx="100" cy="100" rx="80" ry="50" stroke="rgba(255,255,255,0.06)" stroke-width="1" class="orbit orbit-3"/>
            <!-- Animated dots -->
            <circle cx="100" cy="20" r="4" fill="white" class="dot dot-1"/>
            <circle cx="180" cy="100" r="3" fill="white" class="dot dot-2"/>
            <circle cx="60" cy="150" r="3" fill="white" class="dot dot-3"/>
            <circle cx="140" cy="60" r="2" fill="rgba(255,255,255,0.6)" class="dot dot-4"/>
            <circle cx="40" cy="80" r="2" fill="rgba(255,255,255,0.4)" class="dot dot-5"/>
          </svg>
        </div>
      </div>

      <!-- Medium: Decision Makers with image -->
      <div class="bento-card bento-medium has-image">
        <img src="https://images.unsplash.com/photo-1560472354-b33ff0c44a43?w=400&h=300&fit=crop" alt="Business meeting" class="card-bg-image"/>
        <div class="card-overlay">
          <span class="card-number">02</span>
          <h3>Decision Makers</h3>
          <div class="stat-highlight">40%</div>
        </div>
      </div>

      <!-- Medium: Verification with animated check -->
      <div class="bento-card bento-medium">
        <span class="card-number">03</span>
        <h3>Triple Verified</h3>
        <div class="verification-visual">
          <svg class="check-anim" viewBox="0 0 60 60" fill="none">
            <circle cx="30" cy="30" r="28" stroke="rgba(255,255,255,0.1)" stroke-width="2"/>
            <circle cx="30" cy="30" r="28" stroke="white" stroke-width="2" class="check-circle"/>
            <path d="M18 30 L26 38 L42 22" stroke="white" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="check-mark"/>
          </svg>
        </div>
        <div class="stat-highlight">90%+</div>
      </div>

      <!-- Wide: Integrations with logos -->
      <div class="bento-card bento-wide">
        <div class="integration-content">
          <h3>CRM-Ready</h3>
          <p>Export to your favorite tools</p>
        </div>
        <div class="integration-flow">
          <!-- Animated data flow -->
          <svg class="flow-svg" viewBox="0 0 300 60" fill="none">
            <line x1="0" y1="30" x2="300" y2="30" stroke="rgba(255,255,255,0.1)" stroke-width="1"/>
            <circle cx="50" cy="30" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
            <circle cx="150" cy="30" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
            <circle cx="250" cy="30" r="8" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="1"/>
            <circle r="4" fill="white" class="flow-dot flow-dot-1"/>
            <circle r="3" fill="rgba(255,255,255,0.6)" class="flow-dot flow-dot-2"/>
            <circle r="3" fill="rgba(255,255,255,0.4)" class="flow-dot flow-dot-3"/>
          </svg>
          <div class="integration-names">
            <span>HubSpot</span>
            <span>Salesforce</span>
            <span>Sheets</span>
          </div>
        </div>
      </div>

      <!-- Small: 3-in-1 with icon -->
      <div class="bento-card bento-small">
        <svg class="icon-svg" viewBox="0 0 40 40" fill="none">
          <rect x="4" y="4" width="12" height="12" rx="2" stroke="white" stroke-width="1.5" class="icon-box box-1"/>
          <rect x="20" y="4" width="12" height="12" rx="2" stroke="white" stroke-width="1.5" class="icon-box box-2"/>
          <rect x="12" y="20" width="12" height="12" rx="2" stroke="white" stroke-width="1.5" class="icon-box box-3"/>
        </svg>
        <span class="small-label">3-in-1</span>
        <p>Scrape + Enrich + Verify</p>
      </div>

      <!-- Small: Real-time with pulse -->
      <div class="bento-card bento-small">
        <svg class="pulse-svg" viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="4" fill="white"/>
          <circle cx="20" cy="20" r="10" stroke="white" stroke-width="1" class="pulse-ring ring-1"/>
          <circle cx="20" cy="20" r="16" stroke="rgba(255,255,255,0.5)" stroke-width="1" class="pulse-ring ring-2"/>
        </svg>
        <span class="small-label">Real-time</span>
        <p>Live data extraction</p>
      </div>

    </div>

  </div>
</section>

<style>
  .features-section {
    padding: 8rem 0;
  }

  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-header {
    text-align: center;
    margin-bottom: 4rem;
  }

  .section-label {
    display: inline-block;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 1.5rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin: 0;
  }

  .accent-serif {
    font-family: 'Instrument Serif', serif;
    font-style: italic;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.6);
  }

  /* Bento Grid */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: minmax(180px, auto);
    gap: 1rem;
  }

  .bento-large { grid-column: span 2; grid-row: span 2; }
  .bento-medium { grid-column: span 1; }
  .bento-wide { grid-column: span 2; }
  .bento-small { grid-column: span 1; }

  /* Card Base */
  .bento-card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .bento-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  .card-number {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    color: rgba(255, 255, 255, 0.25);
    margin-bottom: 0.75rem;
  }

  .bento-card h3 {
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: white;
    margin: 0 0 0.5rem;
    letter-spacing: -0.02em;
  }

  .bento-card p {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.5;
    margin: 0;
  }

  /* Large Card */
  .bento-large {
    padding: 2rem;
  }

  .bento-large .card-content {
    position: relative;
    z-index: 2;
  }

  .bento-large h3 {
    font-size: 1.5rem;
  }

  .bento-large p {
    max-width: 240px;
  }

  .card-visual {
    position: absolute;
    right: -20px;
    bottom: -20px;
    width: 220px;
    height: 220px;
    opacity: 0.8;
  }

  /* Globe SVG Animation */
  .globe-svg {
    width: 100%;
    height: 100%;
  }

  .orbit {
    transform-origin: center;
  }

  .orbit-1 { animation: rotate 20s linear infinite; }
  .orbit-2 { animation: rotate 25s linear infinite reverse; }
  .orbit-3 { animation: rotate 30s linear infinite; }

  @keyframes rotate {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .dot {
    animation: pulse-dot 3s ease-in-out infinite;
  }

  .dot-1 { animation-delay: 0s; }
  .dot-2 { animation-delay: 0.5s; }
  .dot-3 { animation-delay: 1s; }
  .dot-4 { animation-delay: 1.5s; }
  .dot-5 { animation-delay: 2s; }

  @keyframes pulse-dot {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.5); }
  }

  /* Card with image */
  .has-image {
    padding: 0;
  }

  .card-bg-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(100%);
    opacity: 0.3;
    transition: all 0.4s ease;
  }

  .has-image:hover .card-bg-image {
    opacity: 0.4;
    filter: grayscale(80%);
  }

  .card-overlay {
    position: relative;
    z-index: 2;
    padding: 1.5rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    background: linear-gradient(to top, rgba(0,0,0,0.8) 0%, transparent 100%);
  }

  /* Verification visual */
  .verification-visual {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .check-anim {
    width: 60px;
    height: 60px;
  }

  .check-circle {
    stroke-dasharray: 176;
    stroke-dashoffset: 176;
    animation: draw-circle 1.5s ease forwards;
    animation-delay: 0.5s;
  }

  .check-mark {
    stroke-dasharray: 40;
    stroke-dashoffset: 40;
    animation: draw-check 0.5s ease forwards;
    animation-delay: 1.5s;
  }

  @keyframes draw-circle {
    to { stroke-dashoffset: 0; }
  }

  @keyframes draw-check {
    to { stroke-dashoffset: 0; }
  }

  .bento-card:hover .check-circle,
  .bento-card:hover .check-mark {
    animation: none;
    stroke-dashoffset: 0;
  }

  /* Stat Highlight */
  .stat-highlight {
    margin-top: auto;
    font-family: 'Cabinet Grotesk', sans-serif;
    font-size: 2.5rem;
    font-weight: 800;
    color: white;
    letter-spacing: -0.03em;
  }

  /* Wide Card - Integrations */
  .bento-wide {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .integration-content h3 {
    margin-bottom: 0.25rem;
  }

  .integration-flow {
    flex: 1;
    max-width: 300px;
  }

  .flow-svg {
    width: 100%;
    height: 60px;
    margin-bottom: 0.5rem;
  }

  .flow-dot {
    animation: flow 3s ease-in-out infinite;
  }

  .flow-dot-1 { animation-delay: 0s; }
  .flow-dot-2 { animation-delay: 0.3s; }
  .flow-dot-3 { animation-delay: 0.6s; }

  @keyframes flow {
    0% { cx: 20; opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 1; }
    100% { cx: 280; opacity: 0; }
  }

  .integration-names {
    display: flex;
    justify-content: space-between;
    padding: 0 30px;
  }

  .integration-names span {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.4);
    font-family: 'IBM Plex Mono', monospace;
  }

  /* Small Cards */
  .bento-small {
    justify-content: center;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  .small-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.6);
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .bento-small p {
    font-size: 0.85rem;
  }

  .icon-svg {
    width: 40px;
    height: 40px;
  }

  .icon-box {
    opacity: 0;
    animation: pop-in 0.3s ease forwards;
  }

  .box-1 { animation-delay: 0.2s; }
  .box-2 { animation-delay: 0.4s; }
  .box-3 { animation-delay: 0.6s; }

  @keyframes pop-in {
    from { opacity: 0; transform: scale(0.5); }
    to { opacity: 1; transform: scale(1); }
  }

  .pulse-svg {
    width: 40px;
    height: 40px;
  }

  .pulse-ring {
    transform-origin: center;
    animation: pulse-ring 2s ease-out infinite;
  }

  .ring-1 { animation-delay: 0s; }
  .ring-2 { animation-delay: 0.5s; }

  @keyframes pulse-ring {
    0% { transform: scale(0.8); opacity: 1; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* Responsive */
  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .bento-large { grid-column: span 2; grid-row: span 1; }
    .bento-wide { grid-column: span 2; }

    .card-visual {
      width: 150px;
      height: 150px;
      right: -10px;
      bottom: -10px;
    }
  }

  @media (max-width: 600px) {
    .bento-grid { grid-template-columns: 1fr; }
    .bento-large, .bento-wide, .bento-medium, .bento-small { grid-column: span 1; }
    .bento-wide { flex-direction: column; text-align: center; }
    .integration-flow { max-width: 100%; }
  }
</style>
