---
---
<section id="features" class="py-24 relative overflow-hidden">
  <div class="container">
    <div class="header mb-16 text-center max-w-2xl mx-auto reveal-on-scroll">
      <h2 class="mb-4">Data mining, <span class="font-serif italic text-gradient">reinvented.</span></h2>
      <p>Forget manual copying. We built a pipeline that scrapes, enriches, and verifies 
      leads faster than you can open a spreadsheet.</p>
    </div>

    <div class="bento-grid">
      <!-- Feature 1: Large -->
      <div class="feature-card large glass-panel reveal-on-scroll">
        <div class="card-content">
          <div class="icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
          <h3>Google Maps Unlocked</h3>
          <p>Scrape any niche in any city. Plumbers in Austin? Marketing agencies in London? If it's on Maps, we pull it.</p>
          <div class="visual-mockup">
            <div class="map-dots">
              <span class="dot d1"></span><span class="dot d2"></span><span class="dot d3"></span>
            </div>
          </div>
        </div>
      </div>

      <!-- Feature 2: Standard -->
      <div class="feature-card glass-panel reveal-on-scroll">
        <div class="card-content">
          <div class="icon-box">
             <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
               <path d="M16 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"></path>
               <circle cx="8.5" cy="7" r="4"></circle>
               <path d="M20 8v6M23 11h-6"></path>
             </svg>
          </div>
          <h3>Decision Makers</h3>
          <p>We bypass generic `info@` emails. Our engine finds the Owner, CEO, or Founder's direct contact.</p>
        </div>
      </div>

      <!-- Feature 3: Standard -->
      <div class="feature-card glass-panel reveal-on-scroll">
        <div class="card-content">
          <div class="icon-box">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 12l2 2 4-4"></path>
              <path d="M12 22c5.523 0 10-4.477 10-10S17.523 2 12 2 2 6.477 2 12s4.477 10 10 10z"></path>
            </svg>
          </div>
          <h3>Triple Verification</h3>
          <p>SMTP checks, catch-all detection, and syntax validation. We guarantee 90%+ deliverability.</p>
        </div>
      </div>

      <!-- Feature 4: Wide -->
      <div class="feature-card wide glass-panel reveal-on-scroll">
        <div class="card-content flex-row">
          <div class="text-side">
            <div class="icon-box">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
              </svg>
            </div>
            <h3>CRM Ready Export</h3>
            <p>Push leads directly to your favorite tools.</p>
          </div>
          <div class="integrations-visual">
            <div class="logo-grid">
              <span>HubSpot</span>
              <span>Salesforce</span>
              <span>Pipedrive</span>
              <span>Clay</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Comparison Table (Restored) -->
    <div class="comparison-section reveal-on-scroll">
      <h3 class="comparison-title">Why switch from the competition?</h3>
      <div class="comparison-table">
        <div class="comparison-row header">
          <span></span>
          <span>PullLeads</span>
          <span>Apollo</span>
          <span>Hunter</span>
        </div>
        <div class="comparison-row">
          <span>Google Maps scraping</span>
          <span class="yes">✓ Yes</span>
          <span class="no">✗ No</span>
          <span class="no">✗ No</span>
        </div>
        <div class="comparison-row">
          <span>Owner/Decision-maker emails</span>
          <span class="yes">✓ Yes</span>
          <span class="partial">~ Limited</span>
          <span class="no">Generic only</span>
        </div>
        <div class="comparison-row">
          <span>Built-in verification</span>
          <span class="yes">✓ Yes</span>
          <span class="partial">Extra cost</span>
          <span class="partial">Basic</span>
        </div>
        <div class="comparison-row">
          <span>Fresh, on-demand data</span>
          <span class="yes">✓ Yes</span>
          <span class="no">Database</span>
          <span class="no">Database</span>
        </div>
        <div class="comparison-row">
          <span>Starting price</span>
          <span class="highlight">$49/mo</span>
          <span>$99/mo</span>
          <span>$49/mo</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .py-24 { padding-top: 6rem; padding-bottom: 6rem; }
  .mb-16 { margin-bottom: 4rem; }
  .mb-4 { margin-bottom: 1rem; }
  .text-center { text-align: center; }
  .max-w-2xl { max-width: 42rem; }
  .mx-auto { margin-left: auto; margin-right: auto; }

  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-rows: auto auto;
    }
    
    .feature-card.large {
      grid-row: span 2;
    }
    
    .feature-card.wide {
      grid-column: span 2;
    }
  }

  @media (min-width: 1024px) {
    .bento-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .feature-card.wide {
      grid-column: span 2;
    }
  }

  .feature-card {
    padding: 2rem;
    transition: transform 0.3s ease, border-color 0.3s ease;
    overflow: hidden;
    position: relative;
  }

  .feature-card:hover {
    border-color: rgba(255,255,255,0.25);
    transform: translateY(-5px);
  }

  /* Glow effect on hover */
  .feature-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), rgba(255,255,255,0.06), transparent 40%);
    opacity: 0;
    transition: opacity 0.5s;
    pointer-events: none;
  }

  .feature-card:hover::before {
    opacity: 1;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 100%;
  }

  .icon-box {
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.05);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  h3 {
    font-size: 1.5rem;
    font-weight: 600;
    font-family: 'Outfit', sans-serif;
  }

  .visual-mockup {
    margin-top: auto;
    height: 120px;
    background: rgba(0,0,0,0.3);
    border-radius: 8px;
    position: relative;
    overflow: hidden;
    border: 1px solid var(--border-subtle);
  }

  .map-dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255,255,255,0.1) 1px, transparent 1px);
    background-size: 20px 20px;
  }

  .dot {
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--accent-glow);
    border-radius: 50%;
    box-shadow: 0 0 10px var(--accent-glow);
  }

  .d1 { top: 30%; left: 20%; animation: blink 3s infinite; }
  .d2 { top: 60%; left: 70%; animation: blink 3s infinite 1s; }
  .d3 { top: 40%; left: 50%; animation: blink 3s infinite 2s; }

  @keyframes blink { 0%, 100% { opacity: 0.4; transform: scale(1); } 50% { opacity: 1; transform: scale(1.5); } }

  .integrations-visual {
    flex: 1;
    display: flex;
    align-items: center;
  }

  .logo-grid {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .logo-grid span {
    padding: 0.5rem 1rem;
    background: rgba(255,255,255,0.05);
    border-radius: 6px;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  @media (min-width: 768px) {
    .card-content.flex-row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
    .text-side { flex: 1; }
  }

  /* Comparison Table */
  .comparison-section {
    margin-top: 5rem;
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .comparison-title {
    text-align: center;
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: var(--text-primary);
  }

  .comparison-table {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .comparison-row {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr;
    padding: 1rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.9rem;
    align-items: center;
  }

  .comparison-row:last-child {
    border-bottom: none;
  }

  .comparison-row.header {
    background: rgba(255,255,255,0.03);
    font-weight: 600;
    color: var(--text-primary);
  }

  .comparison-row span:first-child {
    color: var(--text-secondary);
  }

  .comparison-row span:not(:first-child) {
    text-align: center;
  }

  .yes { color: #34D399; font-weight: 600; }
  .no { color: var(--text-muted); }
  .partial { color: #FBBF24; }
  .highlight { color: var(--accent-glow); font-weight: 700; }

  @media (max-width: 600px) {
    .comparison-row {
      grid-template-columns: 1.5fr 1fr 1fr 1fr;
      padding: 0.75rem 1rem;
      font-size: 0.8rem;
    }
  }
</style>

<script>
  // Mouse tracking for glow effect
  document.querySelectorAll('.feature-card').forEach(card => {
    card.addEventListener('mousemove', (e) => {
      const rect = (card as HTMLElement).getBoundingClientRect();
      const x = (e as MouseEvent).clientX - rect.left;
      const y = (e as MouseEvent).clientY - rect.top;
      (card as HTMLElement).style.setProperty('--mouse-x', `${x}px`);
      (card as HTMLElement).style.setProperty('--mouse-y', `${y}px`);
    });
  });
</script>